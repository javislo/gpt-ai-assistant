APP_DEBUG=true
APP_URL=
APP_PORT=3000
APP_LANG=
APP_WEBHOOK_PATH=
APP_API_TIMEOUT=
APP_MAX_GROUPS=
APP_MAX_USERS=
APP_MAX_PROMPT_MESSAGES=
APP_MAX_PROMPT_TOKENS=
APP_INIT_PROMPT=

HUMAN_NAME=
HUMAN_INIT_PROMPT=

BOT_NAME=
BOT_INIT_PROMPT=
BOT_TONE=
BOT_DEACTIVATED=false

ERROR_MESSAGE_DISABLED=false

VERCEL_TIMEOUT=
VERCEL_PROJECT_NAME=gpt-ai-assistant
VERCEL_TEAM_ID=
VERCEL_ACCESS_TOKEN=
VERCEL_DEPLOY_HOOK_URL=

# Google Gemini API (Free Tier). Create the key in Google AI Studio and set it
# only in Vercel environment variables; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=
GEMINI_AUDIO_MODEL=
GEMINI_TEMPERATURE=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT=
GEMINI_BASE_URL=
GEMINI_API_VERSION=

# Weather (中央氣象署 open data). Without CWA_API_KEY the weather features stay off.
CWA_API_KEY=
# Secret for the morning push endpoint /api/cron/weather (Authorization: Bearer <secret>)
CRON_SECRET=

LINE_TIMEOUT=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

SERPAPI_TIMEOUT=
SERPAPI_API_KEY=
SERPAPI_LOCATION=

# Optional: disabled until all free queue, Redis and signing settings are configured.
LINE_ASYNC_ENABLED=false
LINE_WORKER_ORIGIN=
LINE_WORKER_SECRET=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# FIFO queue (create it once in Upstash with parallelism 1)
QSTASH_QUEUE_NAME=line-agent
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEMINI_DAILY_REQUEST_LIMIT=8
GEMINI_MINUTE_REQUEST_LIMIT=4
