{
  "rewrites": [
    {
      "source": "/api/redis-health",
      "destination": "/api/redis-health"
    },
    {
      "source": "/api/worker",
      "destination": "/api/worker"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*": {
      "maxDuration": 55
    }
  },
  "crons": [
    {
      "path": "/api/cron/weather",
      "schedule": "0 23 * * *"
    }
  ]
}
