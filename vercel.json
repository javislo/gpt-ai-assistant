{
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/notify"
    },
    {
      "source": "/api/worker",
      "destination": "/api/worker"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/**/*": {
      "maxDuration": 55
    }
  }
}
