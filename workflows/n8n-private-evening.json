    {
      "id": "3f838c53-2a50-47bf-b50d-c3b3655ee0a1",
      "name": "組合晚間回顧",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -330,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 固定晚間提問，不假設使用者今日已完成任何事項。\nconst parts = new Intl.DateTimeFormat('en-US', {timeZone:'Asia/Taipei', year:'numeric', month:'2-digit', day:'2-digit'}).formatToParts(new Date());\nconst pick = (key) => parts.find((x) => x.type === key)?.value;\nconst ymd = [pick('year'),pick('month'),pick('day')].join('-');\nconst text = [\n  '🌙 私人 LINE AI Agent｜晚間回顧',\n  '📅 ' + ymd + '（台灣時間）',\n  '',\n  '1️⃣ 今天完成了最重要的哪件事？',\n  '2️⃣ 有哪件待辦需要移到明天？',\n  '3️⃣ 明天最優先要處理的是什麼？',\n  '',\n  '💬 可直接回覆這個 LINE 對話，與 Gemini 討論。',\n  '註：目前未連接待辦資料庫，不會自行判定完成狀態。',\n].join('\\n');\nreturn [{ json: { id: 'evening-' + ymd, text } }];"
      }
    },
    {
      "id": "35cf493d-5701-4813-bcbd-d5646d0efcab",
      "name": "LINE 私人 Push（憑證需自行設定）",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://gpt-ai-assistant-git-feat-private-line-notifications-javis-8772.vercel.app/api/notify",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, text: $json.text }) }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
